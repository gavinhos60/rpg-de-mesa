generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  MASTER
  PLAYER
}

enum GameSessionStatus {
  ACTIVE
  CLOSED
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String?
  characters      Character[]
  campaigns       CampaignMember[]
  startedSessions GameSession[]    @relation("SessionStarter")
  createdPapyri   Papyrus[]        @relation("PapyrusCreator")
  shopDeliveries  ShopDelivery[]   @relation("ShopDeliveryMaster")
  playerNotes     PlayerNote[]
}

model Campaign {
  id           Int              @id @default(autoincrement())
  name         String
  characters   Character[]
  members      CampaignMember[]
  sessions     GameSession[]
  papyri       Papyrus[]
  shops        Shop[]
  shopDeliveries ShopDelivery[]
  playerNotes  PlayerNote[]
}

model CampaignMember {
  id         Int          @id @default(autoincrement())

  userId     Int
  campaignId Int
  role       CampaignRole

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Character {
  id         Int       @id @default(autoincrement())
  name       String
  className  String
  race       String
  level      Int
  avatar     String?
  sheet      Json?

  playerId   Int
  player     User      @relation(fields: [playerId], references: [id])

  campaignId Int?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model GameSession {
  id          Int               @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status      GameSessionStatus @default(ACTIVE)
  roomCode    String
  state       Json?
  startedById Int
  startedBy   User              @relation("SessionStarter", fields: [startedById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campaignId, status])
}

model Papyrus {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  body        String   @db.Text
  imageUrl    String?
  published   Boolean  @default(false)
  createdById Int
  createdBy   User     @relation("PapyrusCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId, published])
}

model Shop {
  id          Int            @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  isOpen      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ShopItem[]
  deliveries  ShopDelivery[]

  @@index([campaignId, isOpen])
}

model ShopItem {
  id             Int            @id @default(autoincrement())
  shopId         Int
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  imageUrl       String?
  price          String
  quantity       Int?
  unlimitedStock Boolean        @default(false)
  category       String
  extraInfo      String?
  available      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deliveries     ShopDelivery[]

  @@index([shopId, available])
}

model ShopDelivery {
  id             Int      @id @default(autoincrement())
  campaignId     Int
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopId         Int
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopItemId     Int
  shopItem       ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemName   String
  shopName       String
  characterId    Int
  characterName  String
  playerId       Int?
  playerName     String?
  quantity       Int
  deliveredById  Int
  deliveredBy    User     @relation("ShopDeliveryMaster", fields: [deliveredById], references: [id], onDelete: Cascade)
  deliveredByName String
  createdAt      DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([shopId, createdAt])
}

model PlayerNote {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("")
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, userId])
}
