generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignRole {
  MASTER
  PLAYER
}

enum GameSessionStatus {
  ACTIVE
  CLOSED
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String?
  characters      Character[]
  campaigns       CampaignMember[]
  startedSessions GameSession[]    @relation("SessionStarter")
}

model Campaign {
  id         Int              @id @default(autoincrement())
  name       String
  characters Character[]
  members    CampaignMember[]
  sessions   GameSession[]
}

model CampaignMember {
  id         Int          @id @default(autoincrement())

  userId     Int
  campaignId Int
  role       CampaignRole

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Character {
  id         Int       @id @default(autoincrement())
  name       String
  className  String
  race       String
  level      Int
  avatar     String?
  sheet      Json?

  playerId   Int
  player     User      @relation(fields: [playerId], references: [id])

  campaignId Int?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model GameSession {
  id          Int               @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status      GameSessionStatus @default(ACTIVE)
  roomCode    String
  state       Json?
  startedById Int
  startedBy   User              @relation("SessionStarter", fields: [startedById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campaignId, status])
}
