{
  "name": "rpg-hub-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('node_modules','@3d-dice','dice-box','dist','assets');const dest=path.join('public','assets');if(fs.existsSync(src)){fs.cpSync(src,dest,{recursive:true});}\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  }
}
